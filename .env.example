# Copy to .env and replace every placeholder. Never commit .env.
# Use URL-safe characters in POSTGRES_PASSWORD (it is embedded in DATABASE_URL).
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=portal
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
TEST_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}_test
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=change-me-seed-password
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI assistant. "mock" needs no key and gives deterministic answers (good for demos and tests).
# For a real model use LLM_PROVIDER=openai with any OpenAI-compatible API, and fill in the three
# values below from your provider's docs (model names change, so none is hard-coded here).
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional, USD per 1M tokens from your provider's pricing page. Used only for the cost log line.
LLM_PRICE_IN=
LLM_PRICE_CACHED=
LLM_PRICE_OUT=
# Time budget for one assistant question, in seconds
LLM_TIMEOUT_S=30
